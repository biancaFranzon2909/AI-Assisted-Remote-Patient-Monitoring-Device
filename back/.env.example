PORT = 3001 
NODE_ENV = "local" # production ou development
INTERNAL_CLIENT = 101
JWT_SECRET = "senha-secreta-123!456"
ACCESS_TOKEN_EXPIRES_IN = "10h"
REFRESH_TOKEN_TTL_DAYS = 30
FRONTEND_URL = "http://localhost"

# Usar esta URL para desenvolvimento local, banco compartilho para desenvolvimento
DATABASE_URL = "postgresql:?sslmode=require&channel_binding=require"
# Máximo de conexões por processo; inteiro positivo finito (padrão: 10).
# Valor inválido impede a inicialização. Aumentar exige decisão operacional.
DB_POOL_MAX=10
RESEND_API_KEY = "re_xxxxxxxxxxxxxxxx"