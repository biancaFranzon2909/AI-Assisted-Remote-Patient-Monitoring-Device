model usuario {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome_usuario       String            @unique @db.VarChar(50)
  hash_senha         String
  nome_completo      String            @db.VarChar(100)
  email              String?           @unique @db.VarChar(100)
  is_active          Boolean           @default(true)
  eventos            administrativo[]
  api_key            apiKey?
  empresas           empresaUsuarios[]
  lancamentos        lancamento[]
  relatorios_criados relatorios_log[]
  tokens             token[]
  projetos           projeto[]         @relation("projetoTousuario")

  @@index([nome_usuario], map: "idx_usuario_nome_usuario")
}
