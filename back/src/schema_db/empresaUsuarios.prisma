model empresaUsuarios {
  usuario_id String    @db.Uuid
  empresa_id String    @db.Uuid
  cargo      Cargos    @default(COLAB)
  criado_em  DateTime? @default(now()) @db.Timestamptz(6)
  empresa    empresa   @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  usuario    usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@id([usuario_id, empresa_id])
}

enum Cargos {
  OWNER
  ADMIN
  COLAB
}
