model atividade {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projeto_id           String        @db.Uuid
  nome_atividade       String        @db.VarChar(100)
  descr_atividade      String?
  horas_previstas      Float?
  horas_gastas         Float         @default(0)
  prioridade           Prioridades   @default(NORMAL)
  is_active            Boolean       @default(true)
  ref_cliente          String?       @db.VarChar(50)
  empresa_id           String        @db.Uuid
  tipo                 TipoAtividade @default(INTERNO)
  data_fim             DateTime      @default(now()) @db.Timestamptz(6)
  data_inicio          DateTime      @default(now()) @db.Timestamptz(6)
  faturado             Boolean       @default(false)
  compartilhado        Boolean       @default(false)
  centro_custo         String?       @db.VarChar(20)
  solicitante          String?       @db.VarChar(50)
  empresa              empresa       @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  projeto              projeto       @relation(fields: [projeto_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_atividade_projeto")
  lancamentos_de_horas lancamento[]
}

enum Prioridades {
  BAIXA
  NORMAL
  ALTA
  CRITICA
}

enum TipoAtividade {
  ESTIMATIVA
  ORCADO
  INTERNO
  CHAMADO
  ESTUDO
  SCC
}
