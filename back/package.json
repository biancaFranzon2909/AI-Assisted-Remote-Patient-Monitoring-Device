{
  "name": "backoffice-backend",
  "version": "2.0.0",
  "description": "Backoffice Backend - TypeScript Edition",
  "main": "./src/server.ts",
  "type": "commonjs",
  "scripts": {
    "postinstall": "npx prisma generate",
    "local:set": "npm install -g npm-check-updates@latest npm@latest typescript@latest nodemon@latest && npm install",
    "local:upgrade": "ncu -u && npm i",
    "global:upgrade": "npm update -g npm-check-updates@latest && ncu -g -u",
    "render:build": "npm ci --include=dev && npm run build && npx prisma migrate deploy",
    "dev": "nodemon --watch src --exec tsx src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/src/server.js",
    "seed": "tsx mockup/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "9.0.3",
    "resend": "^6.28.1",
    "tsc-alias": "^1.9.2",
    "tsconfig-paths": "4.2.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^26.3.0",
    "nodemon": "3.1.14",
    "prisma": "^7.10.0",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "tsx": "4.23.12",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "argon2@0.45.1": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
